{
  "repos": {
    "nelsong6/avatars": {
      "suites": [
        "cluster-service",
        "go"
      ],
      "go": {
        "platforms": [
          "ubuntu-latest"
        ]
      },
      "service": {
        "postgres": "artifacts.home.romaine.life/dockerhub/library/postgres:18.6-trixie@sha256:e3d24f6906d0760bf4da0dae872415391ededefad23fd471c47dc53b0ddf3c42"
      },
      "cluster": {
        "renders": [
          {
            "kind": "kustomize",
            "path": "k8s"
          }
        ],
        "image": "forgejo.romaine.life/nelsong6/avatars",
        "baoRole": "avatars-publish",
        "baoSecret": "services/avatars-build",
        "pinFile": "k8s/deployment.yaml",
        "workPackage": "https://openproject.home.romaine.life/wp/PIPT-12"
      }
    },
    "nelsong6/journal-music": {
      "suites": [
        "docs"
      ],
      "docs": {
        "required": [
          "README.md",
          "INDEX.md",
          "CLAUDE.md",
          "gear.md",
          "accounts.md"
        ]
      }
    },
    "nelsong6/vacations": {
      "suites": [
        "docs",
        "python"
      ]
    },
    "romaine-life/ambience": {
      "suites": [
        "go",
        "tofu",
        "web-app"
      ],
      "web": {
        "packages": [
          "."
        ],
        "node": "24",
        "image": "romainecr.azurecr.io/ambience",
        "pinFile": "chart/ambience/values.yaml",
        "workPackage": "https://openproject.home.romaine.life/wp/PIPT-12"
      },
      "tofu": {
        "version": "1.11.0",
        "backend": {
          "resource_group_name": "infra",
          "storage_account_name": "nelsontofu",
          "container_name": "tfstate",
          "key": "ambience.tfstate"
        }
      },
      "inputs": {
        "web-app.test": [
          "cmd/ambience/web/**",
          "scripts/**/*.mjs",
          "scripts/fixtures/**",
          "chart/ambience/**"
        ]
      }
    },
    "romaine-life/at-claude": {
      "suites": [
        "go",
        "release"
      ],
      "release": {
        "toolchains": [
          "go"
        ],
        "prefix": "v0.1",
        "homeSync": true,
        "goTargets": [
          {
            "goos": "windows",
            "goarch": "amd64"
          }
        ],
        "assets": [
          "dist/at-claude-windows-amd64.exe"
        ]
      }
    },
    "romaine-life/at-home-tools": {
      "suites": [
        "go",
        "release"
      ],
      "go": {
        "platforms": [
          "windows-latest"
        ],
        "dependencies": [
          "github.com/romaine-life/agent-tools"
        ]
      },
      "release": {
        "toolchains": [
          "go"
        ],
        "prefix": "v1.0",
        "homeSync": true,
        "goStampPackages": [
          "github.com/romaine-life/at-home-tools/internal/buildinfo"
        ],
        "goTargets": [
          {
            "goos": "windows",
            "goarch": "amd64",
            "packages": [
              "./cmd/...",
              "github.com/romaine-life/agent-tools/cmd/agent-guidance",
              "github.com/romaine-life/agent-tools/cmd/claude-pane",
              "github.com/romaine-life/agent-tools/cmd/pr-logs",
              "github.com/romaine-life/agent-tools/cmd/pr-ready",
              "github.com/romaine-life/agent-tools/cmd/pr-status",
              "github.com/romaine-life/agent-tools/cmd/pr-watch",
              "github.com/romaine-life/agent-tools/cmd/prompt-links",
              "github.com/romaine-life/agent-tools/cmd/strip-owner",
              "github.com/romaine-life/agent-tools/cmd/tmux-strip",
              "github.com/romaine-life/agent-tools/cmd/wp"
            ]
          },
          {
            "goos": "linux",
            "goarch": "amd64",
            "packages": [
              "./cmd/homesvc",
              "github.com/romaine-life/agent-tools/cmd/agent-guidance"
            ]
          },
          {
            "goos": "linux",
            "goarch": "arm64",
            "packages": [
              "./cmd/router-agent"
            ]
          },
          {
            "goos": "darwin",
            "goarch": "amd64",
            "packages": [
              "github.com/romaine-life/agent-tools/cmd/agent-guidance"
            ]
          },
          {
            "goos": "darwin",
            "goarch": "arm64",
            "packages": [
              "github.com/romaine-life/agent-tools/cmd/agent-guidance"
            ]
          }
        ],
        "windowsGui": [
          "./cmd/claude-transcripts",
          "./cmd/event-logs",
          "./cmd/ics-to-gcal",
          "./cmd/log-ship"
        ],
        "assetNames": {
          "go-windows-amd64": {
            "*-windows-amd64.exe": "*.exe"
          }
        }
      }
    },
    "romaine-life/shell-config-profile-5": {
      "suites": [
        "powershell"
      ],
      "powershell": {
        "windowsPowerShell": true
      }
    }
  }
}
